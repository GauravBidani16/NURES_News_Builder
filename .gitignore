# ==============================================================================
# Git Ignore Rules for News Post Builder
# ==============================================================================

# --- Environments and Virtual Environments ---
.venv/
env/
venv/
ENV/
.env.virtualenv

# --- Environment Secrets & API Keys ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# --- Local Databases & Data Directories ---
data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# --- Python Bytecode & Build Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Testing, Linting & Coverage ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Application Logs & Temp Files ---
*.log
logs/
scratch/
tmp/
*.swp
*.swo
*~

# --- IDE & Editor Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Operating System Files (macOS & Windows) ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
