# App Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/app.db
LOG_LEVEL=INFO

# LLM Configuration
# Provider choices: gemini, anthropic (gemini default per user configuration)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_llm_api_key_here
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
HEADLINE_COUNT=3
DESCRIPTION_COUNT=3
DESCRIPTION_MAX_CHARS=300
MAX_MORE_ROUNDS=5
PROMPT_VERSION=v1

# Fetching Settings
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=5000000
FETCH_USER_AGENT=NewsPostBuilder/1.0 (+https://example.com/bot)
MIN_ARTICLE_CHARS=300

# WordPress Integration (Publishing disabled by default; dry-run only)
WP_BASE_URL=https://example.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=your_wp_app_password
WP_NEWS_CATEGORY_SLUG=news
WP_NEWS_CATEGORY_ID=
WP_POST_STATUS=draft
WP_PUBLISH_ENABLED=false
WP_CONTENT_MAP=both
